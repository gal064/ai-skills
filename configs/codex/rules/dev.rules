prefix_rule(pattern = ["docker", "system"], decision = "prompt", justification = "Docker system operations can remove broad Docker state.")
prefix_rule(pattern = ["docker", "volume", "rm"], decision = "prompt", justification = "Removing a volume can permanently delete data.")
prefix_rule(pattern = ["docker", "volume", "prune"], decision = "prompt", justification = "Pruning volumes can permanently delete data.")
prefix_rule(pattern = ["docker", "container", "prune"], decision = "prompt", justification = "Pruning containers removes Docker state.")
prefix_rule(pattern = ["docker", "image", "prune"], decision = "prompt", justification = "Pruning images removes Docker state.")
prefix_rule(pattern = ["docker", "network", "prune"], decision = "prompt", justification = "Pruning networks removes Docker state.")
prefix_rule(pattern = ["docker", "builder", "prune"], decision = "prompt", justification = "Pruning build caches removes Docker state.")
prefix_rule(pattern = ["docker", "buildx", "prune"], decision = "prompt", justification = "Pruning build caches removes Docker state.")
prefix_rule(pattern = ["docker", "compose", "down"], decision = "prompt", justification = "Compose down can remove containers, networks, and volumes.")
prefix_rule(pattern = ["docker-compose", "down"], decision = "prompt", justification = "Compose down can remove containers, networks, and volumes.")
